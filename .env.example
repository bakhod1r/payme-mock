# Copy to .env and adjust. Personal overrides belong in .env.local, which is
# not committed; oneenv reads .env first, then .env.local, then the files for
# the active APP_ENV. All of them are optional — in a container the whole
# configuration arrives as environment variables instead.

# ---------------------------------------------------------------------------
# Console (required)
# ---------------------------------------------------------------------------

# The console shows every sandbox's keys, so it refuses to start without a
# password. There is no default.
CONSOLE_USER=admin
CONSOLE_PASSWORD=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# Host ports differ from the defaults so the stand does not collide with a
# PostgreSQL or Redis already running on this machine.
DATABASE_URL=postgres://payme:payme@localhost:5433/paymemock?sslmode=disable
REDIS_ADDR=localhost:6380

# Turn off when a deployment migrates separately.
DB_MIGRATE_ON_START=true

# ---------------------------------------------------------------------------
# Service addresses
# ---------------------------------------------------------------------------

# merchant  :8081   the Merchant API webhook Payme calls
# paymemock :8082   the Subscribe API and checkout emulator
# console   :8080   the control UI
# gateway   :8443   HTTPS front door
#
# Each service reads HTTP_ADDR, so set it per service rather than globally.

# Where the merchant sends Subscribe API calls. Point this at
# https://checkout.test.paycom.uz/api to run against the real provider instead
# of the emulator; no merchant code changes.
SUBSCRIBE_BASE_URL=http://localhost:8082/api

# Where the emulator sends Merchant API webhooks.
MERCHANT_BASE_URL=http://localhost:8081

# The base of each sandbox's endpoint URL, which is what gets pasted into the
# cash register settings.
GATEWAY_BASE_URL=https://merchant.localhost:8443

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

# local        self-signed certificate from the gateway's own CA
# exposed      local TLS behind a public address or tunnel
# prod         real certificates from Let's Encrypt
# behind_proxy plain HTTP because nginx or Caddy terminates TLS
GATEWAY_MODE=local

# Only used in prod mode.
#GATEWAY_DOMAINS=pay.example.uz,api.example.uz
#ACME_EMAIL=ops@example.uz

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=info
