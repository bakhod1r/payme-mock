# Copy to .env and adjust. Personal overrides belong in .env.local, which is
# not committed; oneenv reads .env first, then .env.local, then the files for
# the active APP_ENV. All of them are optional — in a container the whole
# configuration arrives as environment variables instead.
#
# Every key below is listed with its built-in default, so this file is also the
# inventory of what exists. Only the two console credentials have no default.

# ---------------------------------------------------------------------------
# Console (required)
# ---------------------------------------------------------------------------

# The console shows every sandbox's keys, so it refuses to start without a
# password. There is no default.
CONSOLE_USER=admin
CONSOLE_PASSWORD=

# A request from this machine skips the login, which is what makes the local
# stand usable. It never applies to a request arriving over the network.
CONSOLE_OPEN_ON_LOOPBACK=true

# Widens that to any private address. Docker rewrites the peer to the bridge
# gateway, so a browser on this machine arrives from 172.x and the loopback
# test never matches. Only safe while the published port is bound to 127.0.0.1
# — on every interface it hands every sandbox's keys to the network.
CONSOLE_TRUST_PRIVATE_NET=false

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# Host ports differ from the defaults so the stand does not collide with a
# PostgreSQL or Redis already running on this machine.
DATABASE_URL=postgres://payme:payme@localhost:5433/paymemock?sslmode=disable
REDIS_ADDR=localhost:6380
#REDIS_PASSWORD=
REDIS_DB=0

# Turn off when a deployment migrates separately.
DB_MIGRATE_ON_START=true

# ---------------------------------------------------------------------------
# Published host ports (docker-compose only)
# ---------------------------------------------------------------------------

# These reach docker-compose, not the services: each container keeps listening
# on the fixed port its siblings address it by, and only the host side moves.
# Change one to put the stand somewhere else on this machine.
#
# Moving POSTGRES_HOST_PORT means editing the 5433 in DATABASE_URL to match;
# the containers reach postgres:5432 directly and are unaffected.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MERCHANT_HOST_PORT=8081
PAYMEMOCK_HOST_PORT=8082
CONSOLE_HOST_PORT=8080
#GATEWAY_HOST_PORT=8443

# Loopback deliberately, for the reason given under CONSOLE_TRUST_PRIVATE_NET.
CONSOLE_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Service addresses
# ---------------------------------------------------------------------------

# merchant  :8081   the Merchant API webhook Payme calls
# paymemock :8082   the Subscribe API and checkout emulator
# console   :8080   the control UI
# gateway   :8443   HTTPS front door
#
# Each service reads HTTP_ADDR, so set it per service rather than globally.
# Under compose it is set per container; running the services directly, put it
# on the command line: HTTP_ADDR=:8081 go run ./cmd/merchant
#HTTP_ADDR=

# Where the merchant sends Subscribe API calls. Point this at
# https://checkout.test.paycom.uz/api to run against the real provider instead
# of the emulator; no merchant code changes.
SUBSCRIBE_BASE_URL=http://localhost:8082/api

# Where the emulator sends Merchant API webhooks.
MERCHANT_BASE_URL=http://localhost:8081

# The base of generated checkout links, which is what a payer's browser opens.
CHECKOUT_BASE_URL=http://localhost:8082

# The base of each sandbox's endpoint URL, which is what gets pasted into the
# cash register settings.
GATEWAY_BASE_URL=https://merchant.localhost:8443

# Where the stand's own APIs answer, used for the copyable curl the console
# shows on a logged call. It is the operator's side of the wire: a command
# pasted into a terminal has to reach the stand from where that terminal is.
STAND_BASE_URL=http://localhost

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Read the client address from X-Forwarded-For instead of the peer. On, because
# both services normally sit behind the gateway or behind Docker, where the
# peer is a proxy. Exposed directly it must be off, or a caller could name any
# address it likes and walk past the address checks.
TRUST_FORWARDED_FOR=true

# How long a repeated Subscribe API write is answered out of its first
# response. The real API carries no idempotency field, so the stand recognises
# the repeat by the JSON-RPC id. Set 0 to let repeats through, which is the
# provider's own behaviour and what a rehearsal of duplicate payouts needs.
IDEMPOTENCY_WINDOW=24h

# How long to let in-flight requests finish on shutdown.
SHUTDOWN_TIMEOUT=15s

# How many background steps the worker runs at once.
WORKER_CONCURRENCY=10

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

# local        self-signed certificate from the gateway's own CA
# exposed      local TLS behind a public address or tunnel
# prod         real certificates from Let's Encrypt
# behind_proxy plain HTTP because nginx or Caddy terminates TLS
GATEWAY_MODE=local

# What the gateway proxies to. Compose service names, so they resolve inside
# the stand's network and nowhere else.
MERCHANT_UPSTREAM=http://merchant:8081
PAYMEMOCK_UPSTREAM=http://paymemock:8082

# Where the local CA and certificates are kept.
CERT_DIR=/certs

# Only used in prod mode.
#GATEWAY_DOMAINS=pay.example.uz,api.example.uz
#ACME_EMAIL=ops@example.uz

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=info
