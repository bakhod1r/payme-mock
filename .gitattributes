# The playground's WebAssembly build is a binary artefact: diffing it is noise
# and GitHub should not try to render it as text.
*.wasm binary linguist-generated=true

# Go's own loader, copied from GOROOT rather than written here.
docs/playground/wasm_exec.js linguist-vendored=true

# The console snapshot is generated by scripts/snapshot-console.py.
docs/demo/*.html linguist-generated=true
